{
  "distro_name": "Yaran Tiling",
  "version": "2.1.3",
  "architecture": "amd64",
  "suite": "trixie",
  "debootstrap_variant": "minbase",
  "apt_mirror": "http://deb.debian.org/debian",
  "apt_components": ["main", "contrib", "non-free", "non-free-firmware"],
  "apt_sources": [
    "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware",
    "deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware",
    "deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware"
  ],
  "hostname": "yaran",
  "locale": "en_US.UTF-8",
  "timezone": "UTC",
  "root_password": null,
  "live_username": "admin",
  "live_user_password": "yaranlinux",
  "packages": [
    "firmware-linux", "firmware-linux-free", "firmware-linux-nonfree",
    "firmware-iwlwifi", "firmware-realtek", "firmware-brcm80211",
    "firmware-atheros", "firmware-mediatek", "firmware-misc-nonfree",
    "firmware-intel-sound", "firmware-intel-graphics", "bluez-firmware",
    "intel-microcode", "amd64-microcode", "libgl1-mesa-dri", "libglx-mesa0",
    "mesa-vulkan-drivers", "mesa-va-drivers", "mesa-vdpau-drivers", "libvulkan1",
    "xwayland", "sway", "swaybg", "swayidle", "swaylock", "swayosd",
    "waybar", "foot", "wofi", "mako-notifier", "brightnessctl", "grim",
    "slurp", "wl-clipboard", "network-manager", "network-manager-gnome",
    "wpasupplicant", "bluez", "blueman", "udisks2", "xdg-user-dirs", "xdg-utils",
    "dbus-user-session", "xdg-desktop-portal", "xdg-desktop-portal-wlr",
    "xdg-desktop-portal-gtk", "pipewire", "pipewire-pulse", "pipewire-alsa",
    "pipewire-audio", "wireplumber", "gstreamer1.0-pipewire",
    "libspa-0.2-bluetooth", "rtkit", "alsa-ucm-conf", "alsa-utils", "pavucontrol",
    "upower", "power-profiles-daemon", "thermald", "polkitd", "mate-polkit",
    "ca-certificates", "bash-completion", "systemd-timesyncd", "fonts-vazirmatn",
    "fonts-vazirmatn-variable", "fonts-noto-core", "fonts-noto-cjk",
    "fonts-noto-mono", "fonts-noto-ui-core", "fonts-hosny-amiri",
    "fonts-noto-color-emoji", "fonts-freefont-ttf", "fonts-dejavu-core",
    "fonts-font-awesome", "hicolor-icon-theme", "adwaita-icon-theme",
    "hunspell-en-us", "hyphen-en-us", "cups", "cups-filters", "cups-client",
    "system-config-printer", "fwupd", "calamares", "pkexec",
    "qml6-module-org-kde-kirigami", "qml6-module-qtquick",
    "qml6-module-qtquick-controls", "qml6-module-qtquick-layouts",
    "qml6-module-qtquick-window", "qml6-module-qt5compat-graphicaleffects", "parted", "gdisk", "dosfstools", "e2fsprogs",
    "btrfs-progs", "xfsprogs", "ntfs-3g", "cryptsetup", "os-prober", "efibootmgr",
    "apparmor", "apparmor-profiles", "apparmor-utils", "nftables",
    "unattended-upgrades", "libpam-systemd", "sddm", "plymouth", "plymouth-themes",
    "curl", "wget", "git", "fastfetch", "vim", "tmux", "ranger",
    "squashfs-tools", "rsync", "zram-tools"
  ],
  "exclude_packages": [
    "kde-plasma-desktop", "plasma-workspace", "kwin-x11", "kwin-wayland",
    "powerdevil", "plasma-pa", "plasma-nm", "bluedevil",
    "xdg-desktop-portal-kde", "dolphin", "kate", "konsole", "nautilus",
    "gnome-shell", "gnome-terminal", "file-roller", "evince", "totem",
    "rhythmbox", "tlp", "tlp-rdw", "zenity",
    "lxqt-session", "lxqt-policykit", "lxqt"
  ],
  "pre_chroot_scripts": ["hooks/desktop/stage-sway-assets.sh"],
  "post_install_scripts": [
    "hooks/common/update-ca-certificates.sh",
    "hooks/desktop/automatic-updates.sh",
    "hooks/desktop/firewall.sh",
    "hooks/desktop/sysctl.sh",
    "hooks/desktop/sway-defaults.sh",
    "hooks/desktop/sway-live-autologin.sh",
    "hooks/desktop/sway-display-manager.sh",
    "hooks/common/install-fastfetch.sh",
    "hooks/common/install-ble.sh",
    "hooks/common/bash-experience.sh",
    "hooks/common/install-calamares.sh",
    "hooks/desktop/grub-theme.sh",
    "hooks/desktop/plymouth-theme.sh",
    "hooks/desktop/sway-branding.sh",
    "hooks/common/cleanup-assets.sh",
    "hooks/common/verify-image.sh",
    "hooks/common/verify-sway-image.sh"
  ],
  "boot_append": "quiet splash live-config.nox11autologin console=ttyS0,115200n8 systemd.journald.forward_to_console=1 systemd.log_target=console",
  "squashfs_compression": "xz",
  "os_release": {
    "NAME": "Yaran Tiling Linux",
    "PRETTY_NAME": "Yaran Tiling Linux 2.1.3 Sway Minimal (trixie) AMD64",
    "ID": "yaran", "ID_LIKE": "debian", "VERSION": "2.1.3", "VERSION_ID": "2.1.3",
    "VARIANT": "Sway Minimal", "VARIANT_ID": "sway-minimal", "LOGO": "yaran",
    "HOME_URL": "https://github.com/ahb1390/Yaran_Tiling_Linux",
    "SUPPORT_URL": "https://github.com/ahb1390/Yaran_Tiling_Linux/issues",
    "BUG_REPORT_URL": "https://github.com/ahb1390/Yaran_Tiling_Linux/issues"
  },
  "install_recommends": false,
  "vendor_repositories": false,
  "user_groups": ["sudo", "audio", "video", "plugdev", "netdev", "dialout"],
  "services": {
    "enable": [
      "sddm", "NetworkManager", "systemd-timesyncd", "bluetooth",
      "power-profiles-daemon", "fstrim.timer", "fwupd-refresh.timer",
      "apparmor", "nftables", "cups", "thermald"
    ],
    "disable": [
      "apt-daily.timer", "apt-daily-upgrade.timer", "unattended-upgrades.service"
    ]
  },
  "grub_menu": {
    "background": "assets/wallpapers/Yaran Emblem/contents/images/1585x992.png"
  },
  "iso_filename": "Yaran-Tiling-2.1.3-amd64-sway-minimal.iso",
  "iso_volume_id": "YARAN_SWAY_213_AMD64"
}
